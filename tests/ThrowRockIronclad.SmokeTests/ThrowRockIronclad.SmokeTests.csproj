<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameDataDir>F:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</GameDataDir>
    <GodotProjectDir>$(MSBuildProjectDirectory)\..\..</GodotProjectDir>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <ProjectReference Include="..\..\ThrowRockIronclad.csproj" />
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.3.8" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)\0Harmony.dll" Private="true" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)\GodotSharp.dll" Private="true" />
    <Reference Include="sts2" HintPath="$(GameDataDir)\sts2.dll" Private="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
